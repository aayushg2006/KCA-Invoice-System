PORT=4000
CORS_ORIGIN=*
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket

# Local development can use a JSON file path.
# Cloud Run can instead inject the raw JSON into FIREBASE_SERVICE_ACCOUNT_JSON from Secret Manager.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json

# Gmail works well with Nodemailer when you use a 16-character Google App Password.
# You can also switch to a custom SMTP host by filling SMTP_HOST / SMTP_PORT instead.
SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME=Your Academy Name

# Use the locally installed Chrome/Edge path if auto-detection does not work.
PUPPETEER_EXECUTABLE_PATH=
