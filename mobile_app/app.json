{
  "expo": {
    "name": "KCA Invoice System",
    "slug": "kca-invoice-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/kca-logo.png",
    "scheme": "kcainvoice",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kca.invoicesystem"
    },
    "android": {
      "package": "com.kca.invoicesystem",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/kca-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#020617",
          "dark": {
            "backgroundColor": "#020617"
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://kca-invoice-backend-497170441120.asia-south1.run.app/api",
      "router": {},
      "eas": {
        "projectId": "553cee58-5abf-474d-a031-07bdd3f3ef08"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
